# Copia este archivo como .env y completa cada valor. Nunca lo subas a git.

# Dominios (crea los registros DNS tipo A apuntando a la IP de la VPS)
DOMINIO_APP=app.tudominio.com
DOMINIO_API=api.tudominio.com
DOMINIO_ARCHIVOS=archivos.tudominio.com
CORREO_TLS=tu-correo@tudominio.com

# Secretos: genera cada uno con   openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
MINIO_USUARIO=mecanicaos
MINIO_CLAVE=

# Datos de tu empresa: aparecen en los términos y la política de privacidad
EMPRESA_NOMBRE=MecánicaOS
EMPRESA_RAZON_SOCIAL=
EMPRESA_RUC=
EMPRESA_DIRECCION=
EMPRESA_CORREO=
EMPRESA_CORREO_PRIVACIDAD=
EMPRESA_CIUDAD=
EMPRESA_HOSTING=
# Pon 1 solo después de que un abogado revise los textos legales
LEGAL_REVISADO=0

# Respaldos
HORA_RESPALDO=03
# Destino fuera del servidor configurado en rclone.conf, p. ej. "b2:mecanicaos-respaldos"
OFFSITE_REMOTE=
